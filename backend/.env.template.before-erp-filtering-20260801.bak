# --- Core (required) ---
# PostgreSQL connection string (Medusa v2 uses PostgreSQL only in production setups).
# Local example (matches docker-compose in this folder):
#   postgres://medusa:medusa@localhost:5432/medusa
DATABASE_URL=

# Strong random strings — minimum 32 characters (do not reuse across environments).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# Public browser URL of this Medusa API (Admin uses it to call the backend).
# Local: http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# Comma-separated origins (no spaces). Must include your storefront and Admin origins.
# Storefront (Vite default): http://localhost:5173
# Admin is served from the same Medusa server; include http://localhost:9000 for local Admin.
STORE_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:9000
ADMIN_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:9000
# Use cookie-backed Admin sessions when the installed Medusa version supports it.
ADMIN_AUTH_TYPE=session

# Local stable QA only. The runtime fixture also requires all local-stable
# launcher guards and is ignored in normal/production stable mode.
EATSIE_RUNTIME_VERIFICATION_FIXTURE=false

# --- Commerce feature rollout gates (disabled until each acceptance phase passes) ---
FEATURE_SUBSCRIPTIONS=false
FEATURE_PERSONALIZED_PRODUCTS=false
FEATURE_BUNDLED_PRODUCTS=false

# --- Redis (recommended for production; optional in many local flows) ---
# When set, Medusa swaps cache / events / workflow engine to Redis-backed implementations.
REDIS_URL=redis://localhost:6379
# Set true only with a rediss:// endpoint. Credentials remain in REDIS_URL.
REDIS_TLS=false
# Namespace for queues, cache keys, workflow jobs, and locks.
REDIS_PREFIX=eatsie

# --- POS production data gates ---
# JSON array consumed by `medusa exec ./src/scripts/configure-pos-approved-tax-rates.ts`.
# Production entries require approved_by, approved_at, and source. USA entries also
# require a state in province_code. TEST fixtures additionally require the explicit
# opt-in below and TEST-prefixed names/codes. Never put unapproved rates here.
# POS_APPROVED_TAX_RATES_JSON=[]
POS_ALLOW_TEST_TAX_FIXTURES=false

# Isolated POS E2E inventory fixture. This never fills production variants and
# requires every quantity/price to be explicit before the fixture script runs.
POS_ALLOW_TEST_INVENTORY_FIXTURE=false
# POS_TEST_USA_STOCKED_QUANTITY=
# POS_TEST_CANADA_STOCKED_QUANTITY=
# POS_TEST_USD_PRICE_NATIVE=
# POS_TEST_CAD_PRICE_NATIVE=

# Non-production, authenticated, one-shot checkout fault injection. The server
# ignores these controls completely when NODE_ENV=production.
POS_ALLOW_FAILURE_INJECTION=false
# POS_FAILURE_INJECTION_TOKEN=minimum-16-character-test-secret

# IDs of authenticated runtime-proof sales. These are consumed read-only by
# `verify:pos-go-live-tax`; they are never guessed from arbitrary orders.
# POS_GO_LIVE_CA_TRANSACTION_ID=
# POS_GO_LIVE_US_TRANSACTION_ID=

# --- Stripe (optional) ---
# Secret key from Stripe Dashboard. When set, the Stripe payment provider is registered (id: stripe → pp_stripe_stripe).
# STRIPE_API_KEY=
# Webhook signing secret (recommended in production for Stripe webhooks).
# STRIPE_WEBHOOK_SECRET=
# Capture automatically after authorization. Set false for manual capture.
STRIPE_CAPTURE=true

# --- PayPal ---
# REST API application credentials from developer.paypal.com.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional, but required for verified PayPal webhook processing.
# PAYPAL_WEBHOOK_ID=

# Firebase Admin credentials are required when deploying a server-side
# Firebase token bridge. Never expose these as VITE_* variables.
FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- PostgreSQL SSL (optional, typical for managed DBs) ---
# DATABASE_SSL=true
# Set to false only if your provider requires insecure TLS (not recommended).
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Tooling only ---
# MEDUSA_SKIP_ENV_CHECK=true

DB_NAME=eatsie_commerce_migration_test_20260730c