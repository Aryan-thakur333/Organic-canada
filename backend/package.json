{
  "name": "backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "admin:prepare-build": "node scripts/prepare-admin-build.js",
    "admin:finalize-build": "node scripts/finalize-admin-build.js",
    "build": "npm run admin:prepare-build && cross-env MEDUSA_SKIP_ENV_CHECK=true medusa build && npm run admin:finalize-build",
    "audit:db-integrity": "medusa exec ./src/scripts/audit-db-integrity.ts",
    "db:create": "medusa db:create",
    "db:migrate": "medusa db:migrate",
    "db:sync-links": "medusa db:sync-links",
    "db:setup": "medusa db:setup",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:subscription-plans": "medusa exec ./src/scripts/seed-subscription-plans.ts",
    "erp:test-product": "medusa exec ./src/scripts/ensure-erp-test-product.ts",
    "erp:inspect-schema": "medusa exec ./src/scripts/inspect-odoo-product-schema.ts",
    "erp:diagnose-product": "medusa exec ./src/scripts/diagnose-odoo-product-inventory.ts",
    "erp:repair-product": "medusa exec ./src/scripts/repair-odoo-product-inventory.ts",
    "repair:storefront": "medusa exec ./src/scripts/repair-storefront-inventory.ts",
    "repair:shipping": "medusa exec ./src/scripts/repair-shipping-configuration.ts",
    "repair:bundle-snapshot": "medusa exec ./src/scripts/repair-legacy-bundle-cart-snapshot.ts --",
    "audit:bundle-snapshot-schema": "medusa exec ./src/scripts/audit-bundle-snapshot-schema.ts",
    "verify:shipping-checkout": "node ./scripts/verify-shipping-checkout.mjs",
    "diagnose:stripe": "medusa exec ./src/scripts/diagnose-stripe-checkout.ts",
    "diagnose:pos-identity": "medusa exec ./src/scripts/pos-identity-diagnostic.ts",
    "audit:pos-production-data": "medusa exec ./src/scripts/audit-pos-production-data.ts",
    "repair:pos-usa-fulfillment": "medusa exec ./src/scripts/repair-pos-usa-fulfillment-link.ts",
    "configure:pos-approved-tax": "medusa exec ./src/scripts/configure-pos-approved-tax-rates.ts",
    "import:pos-approved-tax": "medusa exec ./src/scripts/import-approved-pos-tax-rates.ts",
    "import:pos-approved-inventory": "medusa exec ./src/scripts/import-approved-usa-pos-inventory.ts",
    "fixture:pos-inventory": "medusa exec ./src/scripts/create-pos-isolated-inventory-fixture.ts",
    "verify:pos-infrastructure": "medusa exec ./src/scripts/verify-pos-production-infrastructure.ts",
    "verify:pos-go-live-tax": "medusa exec ./src/scripts/verify-pos-go-live-tax-runtime.ts",
    "audit:variant-barcodes": "medusa exec ./src/scripts/audit-product-variant-identifiers.ts",
    "generate:variant-barcodes": "medusa exec ./src/scripts/generate-missing-internal-barcodes.ts",
    "import:variant-barcodes": "medusa exec ./src/scripts/import-approved-variant-barcodes.ts --",
    "pilot:pos-link": "medusa exec ./src/scripts/link-pos-barcode-pilot-products.ts --",
    "pilot:barcode-approvals": "medusa exec ./src/scripts/prepare-pos-barcode-pilot-approvals.ts",
    "pilot:barcode-verify": "medusa exec ./src/scripts/verify-pos-barcode-pilot.ts",
    "pilot:barcode-labels": "medusa exec ./src/scripts/generate-pos-barcode-pilot-labels.ts",
    "pilot:barcode-write-audit": "medusa exec ./src/scripts/verify-pos-barcode-pilot-writes.ts",
    "pilot:unlink-unsafe-prices": "medusa exec ./src/scripts/unlink-unsafe-pos-barcode-pilot-products.ts --",
    "pilot:audit-cad-prices": "medusa exec ./src/scripts/audit-pos-pilot-cad-prices.ts",
    "pilot:validate-final-cad": "medusa exec ./src/scripts/validate-final-pos-cad-approvals.ts",
    "pilot:backup-final-cad": "powershell -ExecutionPolicy Bypass -File ./scripts/create-final-pos-cad-backup.ps1",
    "pilot:import-cad-prices": "medusa exec ./src/scripts/import-corrected-cad-prices.ts --",
    "pilot:audit-inventory": "medusa exec ./src/scripts/audit-pos-pilot-inventory.ts",
    "pilot:snapshot-state": "medusa exec ./src/scripts/snapshot-pos-pilot-state.ts --",
    "repair:payments": "medusa exec ./src/scripts/repair-payment-providers.ts",
    "start": "medusa start",
    "dev": "node scripts/start-dev.js",
    "dev:direct": "medusa develop",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File scripts/start-medusa-dev.ps1",
    "dev:ps:clean": "powershell -ExecutionPolicy Bypass -File scripts/start-medusa-dev.ps1 -Clean",
    "admin:stable": "node scripts/start-stable.js",
    "admin:stable:rebuild": "node scripts/start-stable.js --rebuild",
    "admin:stable:clean": "node scripts/start-stable.js --rebuild --clean",
    "admin:stable:local": "node scripts/start-stable.js --local",
    "admin:stable:local:rebuild": "node scripts/start-stable.js --local --rebuild",
    "admin:stable:local:clean": "node scripts/start-stable.js --local --rebuild --clean",
    "kill:9000": "powershell -ExecutionPolicy Bypass -File scripts/kill-port-9000.ps1",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:json": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --runInBand --json --outputFile=integration-results.json",
    "test:integration:debug": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --detectOpenHandles",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test": "npm run test:unit",
    "test:int": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:int:one": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern",
    "test:int:b2b": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern='b2b-company-approval-flow'",
    "test:int:b2b-quotes": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern='b2b-quote-flow'",
    "test:int:vendor": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --testPathPattern='vendor-'"
  },
  "dependencies": {
    "@alphabite/medusa-paypal": "^0.2.6",
    "@medusajs/admin-sdk": "2.13.6",
    "@medusajs/cli": "2.13.6",
    "@medusajs/framework": "2.13.6",
    "@medusajs/js-sdk": "^2.15.2",
    "@medusajs/medusa": "2.13.6",
    "@medusajs/payment-stripe": "^2.13.6",
    "@rokmohar/medusa-payment-manual": "^1.0.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "firebase-admin": "^13.4.0",
    "ioredis": "^5.10.1",
    "multer": "^2.0.0",
    "pg": "^8.16.3",
    "react-router-dom": "^6.30.3",
    "sharp": "^0.34.4",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.6",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.2"
}
